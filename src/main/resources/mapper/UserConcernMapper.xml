<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.community.mapper.UserConcernMapper">
    <resultMap id="ConcernMap" type="UserConcern">
        <id column="concern_id" property="concernId"/>
        <result column="preuser" property="preuser"/>
        <result column="lastuser" property="lastuser"/>
    </resultMap>

    <sql id="columns">concern_id, preuser, lastuser</sql>

    <select id="selectByFollowedUserId" resultMap="ConcernMap">
        SELECT <include refid="columns"/> FROM tb_userconcern
        WHERE lastuser = #{followedUserId}
        ORDER BY concern_id ASC
    </select>

    <select id="selectByFollowerId" resultMap="ConcernMap">
        SELECT <include refid="columns"/> FROM tb_userconcern
        WHERE preuser = #{followerId}
        ORDER BY concern_id ASC
    </select>

    <select id="countByUserIds" resultType="long">
        SELECT COUNT(*) FROM tb_userconcern
        WHERE preuser = #{followerId} AND lastuser = #{followedUserId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="concernId">
        INSERT INTO tb_userconcern (preuser, lastuser)
        VALUES (#{preuser}, #{lastuser})
    </insert>

    <delete id="deleteByUserIds">
        DELETE FROM tb_userconcern
        WHERE preuser = #{followerId} AND lastuser = #{followedUserId}
    </delete>
</mapper>
