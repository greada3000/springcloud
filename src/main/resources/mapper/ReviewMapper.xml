<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.community.mapper.ReviewMapper">
    <resultMap id="ReviewMap" type="Review">
        <id column="review_id" property="reviewId"/>
        <result column="owner_id" property="ownerId"/>
        <result column="article_id" property="articleId"/>
        <result column="content" property="content"/>
    </resultMap>

    <sql id="columns">review_id, owner_id, article_id, content</sql>

    <select id="selectById" resultMap="ReviewMap">
        SELECT <include refid="columns"/> FROM tb_review WHERE review_id = #{id}
    </select>

    <select id="selectByArticleId" resultMap="ReviewMap">
        SELECT <include refid="columns"/> FROM tb_review
        WHERE article_id = #{articleId}
        ORDER BY review_id ASC
        LIMIT #{offset}, #{size}
    </select>
    <select id="countByArticleId" resultType="long">SELECT COUNT(*) FROM tb_review WHERE article_id = #{articleId}</select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="reviewId">
        INSERT INTO tb_review (owner_id, article_id, content)
        VALUES (#{ownerId}, #{articleId}, #{content})
    </insert>

    <update id="updateById">
        UPDATE tb_review
        SET owner_id = #{ownerId}, article_id = #{articleId}, content = #{content}
        WHERE review_id = #{reviewId}
    </update>

    <delete id="deleteById">
        DELETE FROM tb_review WHERE review_id = #{id}
    </delete>

    <delete id="deleteByArticleId">
        DELETE FROM tb_review WHERE article_id = #{articleId}
    </delete>
</mapper>
